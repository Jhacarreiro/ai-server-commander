# The application does not load this file automatically.
# Export these values in your shell or process manager.
SAFE_MODE=true
COMMAND_TIMEOUT_MS=120000
MAX_OUTPUT_CHARS=12000
MAX_SCRIPT_BODY_BYTES=524288
MAX_INLINE_COMMAND_BYTES=65536
MAX_CONCURRENT_COMMANDS=8
MAX_NOTICE_TEXT=8192
MAX_NOTICE_SOURCE=256
MAX_ACTIVITY_FIELD=256
MAX_MCP_BATCH=64
COMMAND_OPERATIONS_PATH=./runtime/command-operations.json
COMMAND_OPERATION_TTL_SECONDS=86400
SHELL=/bin/bash
NODE_ENV=production
OAUTH_STATE_PATH=./runtime/oauth-state.json
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MAX_OAUTH_CLIENTS=200
MAX_CLIENT_NAME_CHARS=128
RESTART_FORCE_EXIT_MS=30000
